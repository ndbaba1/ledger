# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# `$XDG_CONFIG_HOME/git/ignore` or `~/.config/git/ignore`

# Ignore bundler config.
/.bundle

# Ignore all environment files.
/.env*

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore key files for decrypting credentials and more.
/config/*.key

# The built frontend — copied in by Docker (api/Dockerfile) for a real
# deploy, or by spec/support/frontend_build.rb for tests. Not committed,
# same as web/dist itself; robots.txt is the only public/ file we own.
/public/assets
/public/brand
/public/site.webmanifest
/app/views/static/index.html

