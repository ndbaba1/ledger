# Copy this to .env and fill in real values before `docker compose up --build`.

# Points the api container at the db container (see compose.yaml).
DATABASE_URL=postgres://postgres:postgres@db:5432/ledger_development

# Create a GitHub OAuth App at https://github.com/settings/developers with
# callback URL http://localhost:8080/auth/github/callback, then paste its
# client ID and secret here.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Any long random string — used to sign and encrypt the session cookie.
# Generate one with: openssl rand -hex 64
SECRET_KEY_BASE=

# The single origin the frontend is served from. The api rejects non-GET
# requests whose Origin header doesn't match this.
APP_URL=http://localhost:8080

# Encrypts stored GitHub OAuth tokens at rest. Generate with:
#   docker compose run --rm api bin/rails db:encryption:init
# Without these, dev/test fall back to fixed, non-secret keys — set real ones
# before running this anywhere real data will live.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=
